# Complexity Backend Environment Configuration

# Server Port (default: 5000)
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS - comma-separated for multiple origins, e.g. http://localhost:3000,https://app.complexity.dev)
CORS_ORIGIN=http://localhost:3000

# Express Trust Proxy: 'loopback', '1' (single reverse proxy hop), 'true', or subnet
TRUST_PROXY=loopback

# AI Provider: 'gemini', 'openai', or 'disabled' (auto-detected if keys are supplied)
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional alternative: https://platform.openai.com/)
# OPENAI_API_KEY=your_openai_api_key_here

# Configurable Model (e.g. 'gemini-1.5-flash', 'gemini-1.5-pro', 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash

# Upstream Request Timeout in Milliseconds
AI_TIMEOUT_MS=15000

# Rate Limiting for /api/optimize
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Maximum Input Code Length
MAX_CODE_LENGTH=50000
